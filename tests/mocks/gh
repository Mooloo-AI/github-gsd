#!/usr/bin/env bash
# Mock gh for the issue-comment.sh and discover.sh tests.
#
# Environment:
#   MOCK_DIR            directory for logs and fixtures (required)
#   MOCK_REPO           repository returned by `gh repo view --jq .nameWithOwner`
#                       (default: acme/widgets)
#   MOCK_FAIL           a call kind to fail: list, create, update, repo, project,
#                       fields, or label
#
# Fixtures in $MOCK_DIR:
#   pages.json          output of the comment list call (concatenated pages)
#   repo.json           output of `gh repo view --json ...` without --jq
#   projects.json       output of `gh project list`
#   fields-<n>.json     output of `gh project field-list <n>`
#   labels.json         output of `gh label list`
#
# Writes:
#   $MOCK_DIR/calls.log      one line per call with its arguments
#   $MOCK_DIR/payload.json   the --input payload of the last create/update call

set -euo pipefail

echo "$*" >>"$MOCK_DIR/calls.log"

fail_if() {
  if [ "${MOCK_FAIL:-}" = "$1" ]; then
    echo "mock gh: $1 failed" >&2
    exit 1
  fi
}

if [ "${1:-}" = "repo" ] && [ "${2:-}" = "view" ]; then
  fail_if repo
  case "$*" in
    *"--jq .nameWithOwner"*) echo "${MOCK_REPO:-acme/widgets}" ;;
    *) cat "$MOCK_DIR/repo.json" ;;
  esac
  exit 0
fi

if [ "${1:-}" = "project" ] && [ "${2:-}" = "list" ]; then
  if [ "${MOCK_FAIL:-}" = "project" ]; then
    echo "error: your authentication token is missing required scopes [read:project]" >&2
    exit 1
  fi
  cat "$MOCK_DIR/projects.json"
  exit 0
fi

if [ "${1:-}" = "project" ] && [ "${2:-}" = "field-list" ]; then
  fail_if fields
  cat "$MOCK_DIR/fields-$3.json"
  exit 0
fi

if [ "${1:-}" = "label" ] && [ "${2:-}" = "list" ]; then
  fail_if label
  cat "$MOCK_DIR/labels.json"
  exit 0
fi

[ "${1:-}" = "api" ] || { echo "mock gh: unsupported command: $*" >&2; exit 64; }
shift

method=GET
input=""
endpoint=""
while [ $# -gt 0 ]; do
  case "$1" in
    --method | -X) method=$2; shift 2 ;;
    --input) input=$2; shift 2 ;;
    --jq | -q) shift 2 ;;
    --paginate) shift ;;
    -*) echo "mock gh: unsupported flag: $1" >&2; exit 64 ;;
    *) endpoint=$1; shift ;;
  esac
done

case "$method $endpoint" in
  "GET repos/"*"/issues/"*"/comments?per_page=100")
    fail_if list
    cat "$MOCK_DIR/pages.json"
    ;;
  "POST repos/"*"/issues/"*"/comments")
    fail_if create
    cp "$input" "$MOCK_DIR/payload.json"
    repo_issue=${endpoint#repos/}
    repo_issue=${repo_issue%/comments}
    echo "https://github.com/${repo_issue}#issuecomment-999"
    ;;
  "PATCH repos/"*"/issues/comments/"*)
    fail_if update
    cp "$input" "$MOCK_DIR/payload.json"
    echo "https://github.com/updated#issuecomment-${endpoint##*/}"
    ;;
  *)
    echo "mock gh: unsupported call: $method $endpoint" >&2
    exit 64
    ;;
esac
